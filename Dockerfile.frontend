# ==============================================================================
# CogniDesk Frontend Multi-Stage Dockerfile (Module 31 — Web Production)
# ==============================================================================

# Stage 1: Build production React + TypeScript bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies (clean install)
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build production bundle targeting dist/ (< 15-20 MB)
RUN npm run build

# Stage 2: Serve optimized static assets with Nginx
FROM nginx:1.25-alpine

# Copy custom Nginx configuration with SPA & SSE support
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built artifacts from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
