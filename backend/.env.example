# CogniDesk Backend Configuration (Module 31 Hosted & Local Web)
APP_NAME="CogniDesk API"
APP_ENV="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# Hosted Website Mode (Set to true in production deployments)
COGNIDESK_HOSTED_MODE=true

# Security & Tamper-Proof Authentication Token Secret
SECRET_KEY="generate-a-secure-random-secret-key-here-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Web Deployment CORS Settings
# Set FRONTEND_URL to your deployed web domain (e.g. https://cognidesk.yourdomain.com)
FRONTEND_URL="https://cognidesk.yourdomain.com"
# Alternatively allow custom comma-separated origins or JSON list:
CORS_ORIGINS=["https://cognidesk.yourdomain.com", "http://localhost:5173", "http://localhost:3000"]
# Set CORS_ALLOW_ALL=true only if using an open public API behind a CDN/gateway
CORS_ALLOW_ALL=false

# Persistent Database Storage:
# Use PostgreSQL in production or persistent SQLite path:
# DATABASE_URL="postgresql://cognidesk_user:cognidesk_password@db:5432/cognidesk_db"
DATABASE_URL="sqlite:///database/cognidesk.db"

# Persistent Vector Store (ChromaDB):
# Leave empty for persistent disk storage at ./vector_db, or specify remote Chroma service:
# CHROMA_SERVER_HOST="chroma"
# CHROMA_SERVER_PORT=8000
# CHROMA_SERVER_SSL=false

# Server-Side Hosted AI Provider Configuration (Never exposed to frontend code)
# Supported: groq, openai, anthropic, openrouter, ollama
HOSTED_LLM_PROVIDER="groq"
HOSTED_LLM_MODEL="llama-3.3-70b-versatile"
# HOSTED_LLM_BASE_URL="https://api.groq.com/openai/v1"

# API Keys for Server-Side Inference (Configure ONLY in server environment)
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Local Ollama fallback (Used if running locally or self-hosting Ollama alongside backend)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_MODEL="llama-3.3-70b-versatile"
EMBEDDING_MODEL="all-minilm"

# Storage Directories (Ensure persistent Docker volume mounts in production)
UPLOAD_DIR="uploads"
VECTOR_DB_DIR="vector_db"
DATABASE_DIR="database"
