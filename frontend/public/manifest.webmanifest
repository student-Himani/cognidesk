{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "cognidesk-ai-workspace",
  "name": "CogniDesk — AI Knowledge & Document Workspace",
  "short_name": "CogniDesk",
  "description": "Installable offline-first AI knowledge workspace with in-browser semantic search, documents, notes, flashcards, and private AI inference.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#020617",
  "categories": ["productivity", "education", "utilities"],
  "icons": [
    {
      "src": "/icons/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "AI Chat",
      "short_name": "Chat",
      "description": "Start a document conversation or AI chat",
      "url": "/chat",
      "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Knowledge Notes",
      "short_name": "Notes",
      "description": "View and create offline notes",
      "url": "/notes",
      "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Flashcards Study",
      "short_name": "Flashcards",
      "description": "Study active recall decks",
      "url": "/flashcards",
      "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
